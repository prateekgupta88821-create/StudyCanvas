rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if the user is authenticated
    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    // Helper function to check if user owns the document by ID
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Users Collection: Each user can only read and write their own profile
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.uid == userId;
      allow update: if isOwner(userId) && request.resource.data.uid == userId;
      allow delete: if false; // Deletions must go through administrative processes
    }

    // Whiteboard Projects Collection
    match /projects/{projectId} {
      // Allow reading only if authenticated user is the owner
      allow read: if isAuthenticated() && (
        resource == null || resource.data.ownerId == request.auth.uid
      );

      // Enforce that new project ownerId matches the authenticated user UID
      allow create: if isAuthenticated() && 
        request.resource.data.ownerId == request.auth.uid;

      // Prevent changing project ownership on updates
      allow update: if isAuthenticated() && 
        resource.data.ownerId == request.auth.uid &&
        request.resource.data.ownerId == request.auth.uid;

      // Allow deleting only if user owns the project
      allow delete: if isAuthenticated() && 
        resource.data.ownerId == request.auth.uid;
    }
  }
}
