rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if the user is authenticated
    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    // Helper function to check if user owns the document by ID
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Users Collection: Each user can only read and write their own profile
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.uid == userId;
      allow update: if isOwner(userId) && request.resource.data.uid == userId;
      allow delete: if false; // Deletions must go through administrative processes
    }

    // Whiteboard Projects Collection & Collaborator Security Rules
    match /projects/{projectId} {
      // Helper function to check project ownership
      function isProjectOwner() {
        return isAuthenticated() && (
          resource.data.ownerId == request.auth.uid ||
          (resource == null && request.resource.data.ownerId == request.auth.uid)
        );
      }

      // Check if user is an authorized collaborator
      function isCollaborator() {
        return isAuthenticated() && (
          isProjectOwner() ||
          exists(/databases/$(database)/documents/projects/$(projectId)/collaborators/$(request.auth.uid)) ||
          (resource != null && resource.data.collaborators != null && request.auth.uid in resource.data.collaborators)
        );
      }

      // Get collaborator role: 'owner', 'editor', 'commenter', 'viewer'
      function getCollaboratorRole() {
        return isProjectOwner() ? 'owner' :
          exists(/databases/$(database)/documents/projects/$(projectId)/collaborators/$(request.auth.uid)) ?
            get(/databases/$(database)/documents/projects/$(projectId)/collaborators/$(request.auth.uid)).data.role :
          (resource != null && resource.data.collaborators != null && request.auth.uid in resource.data.collaborators) ?
            resource.data.collaborators[request.auth.uid] : 'none';
      }

      // Allow reading only if owner or authorized collaborator
      allow read: if isAuthenticated() && (resource == null || isCollaborator());

      // Only project owner can create a new project
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;

      // Editors and Owners can update project contents; Viewers and Commenters cannot update elements
      allow update: if isAuthenticated() && (
        isProjectOwner() || 
        (isCollaborator() && getCollaboratorRole() == 'editor' && request.resource.data.ownerId == resource.data.ownerId)
      );

      // Only owner can delete project
      allow delete: if isProjectOwner();

      // Collaborators Subcollection
      match /collaborators/{collaboratorId} {
        // Any authorized collaborator or project member can see who is collaborating
        allow read: if isAuthenticated() && (isProjectOwner() || isCollaborator());

        // Only project owner can invite, modify roles, or remove collaborators
        allow create, update, delete: if isProjectOwner();
      }

      // Real-time Presence & Cursor Subcollection
      match /presence/{userId} {
        // Any collaborator can read presence
        allow read: if isAuthenticated() && isCollaborator();

        // Users can only update their own presence/cursor document
        allow create, update: if isAuthenticated() && isCollaborator() && request.auth.uid == userId;
        allow delete: if isAuthenticated() && (request.auth.uid == userId || isProjectOwner());
      }

      // Real-time Comments Subcollection
      match /comments/{commentId} {
        // Any collaborator (viewer, commenter, editor, owner) can read comments
        allow read: if isAuthenticated() && isCollaborator();

        // Commenters, Editors, and Owners can create comments
        allow create: if isAuthenticated() && isCollaborator() && 
          (getCollaboratorRole() in ['owner', 'editor', 'commenter']) &&
          request.resource.data.authorId == request.auth.uid;

        // Comment author or project owner can update or resolve comments
        allow update: if isAuthenticated() && isCollaborator() && (
          isProjectOwner() ||
          resource.data.authorId == request.auth.uid ||
          (getCollaboratorRole() in ['owner', 'editor'] && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['resolved', 'resolvedAt', 'resolvedBy']))
        );

        // Comment author or project owner can delete comments
        allow delete: if isAuthenticated() && (isProjectOwner() || resource.data.authorId == request.auth.uid);
      }

      // Real-time Live Presentation / Follow State
      match /presentation/{sessionId} {
        allow read: if isAuthenticated() && isCollaborator();
        allow write: if isAuthenticated() && isCollaborator() && (
          isProjectOwner() || getCollaboratorRole() in ['owner', 'editor']
        );
      }
    }
  }
}
