# ==========================================
# StudyCanvas — Environment Configuration
# ==========================================
# Copy this file to .env.local or .env in your root directory.
# NEVER commit your real secrets to version control.

# Firebase Web App Credentials (from Firebase Console -> Project Settings -> General -> Your apps)
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_firebase_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Google Cloud OAuth Credentials (from Google Cloud Console -> APIs & Services -> Credentials)
# Required for Google Drive Integration (https://www.googleapis.com/auth/drive.file scope)
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
VITE_GOOGLE_API_KEY=your_google_api_key_here

# Server-side Privileged Secrets (Used by Vercel Serverless Functions in /api)
# Configure these in your Vercel Project Environment Variables dashboard
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
FIREBASE_SERVICE_ACCOUNT_KEY=your_firebase_admin_service_account_json_or_private_key
APP_URL=http://localhost:5173
